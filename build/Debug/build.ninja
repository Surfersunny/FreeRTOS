  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\DELL\Desktop\Demo\build\Debug\cmake\stm32cubemx && D:\CMake\bin\cmake-gui.exe -SC:\Users\DELL\Desktop\Demo -BC:\Users\DELL\Desktop\Demo\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build cmake/stm32cubemx/edit_cache: phony cmake/stm32cubemx/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build cmake/stm32cubemx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\DELL\Desktop\Demo\build\Debug\cmake\stm32cubemx && D:\CMake\bin\cmake.exe --regenerate-during-build -SC:\Users\DELL\Desktop\Demo -BC:\Users\DELL\Desktop\Demo\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

